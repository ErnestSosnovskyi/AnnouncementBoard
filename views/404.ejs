<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <title>404 - Не знайдено</title>
  <link rel="stylesheet" href="./styles.css">
</head>
<body>
  <div class="container" style="text-align: center; padding-top: 80px;">
    <h1 style="font-size: 80px; color: var(--danger-color);">404</h1>
    <h2><%= typeof message !== 'undefined' ? message : 'Сторінку не знайдено' %></h2>
    <p style="margin: 20px 0; color: var(--text-muted);">Запитуване оголошення або сторінка за цим посиланням відсутня.</p>
    <a href="/" class="btn">Повернутися на головну</a>
  </div>
</body>
</html>