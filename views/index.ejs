<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <title>Дошка оголошень</title>
  <link rel="stylesheet" href="./styles.css">
</head>
<body>
  <div class="container">
    <header>
      <h1><a href="/">Дошка оголошень</a></h1>
      <a href="/announcements" class="btn">Додати оголошення</a>
    </header>

    <div class="controls-panel">
      <form action="/" method="GET" class="search-group">
        <label for="search">Пошук</label>
        <div style="display: flex; gap: 10px;">
            <input type="text" name="search" class="input-text" placeholder="Шукати оголошення..." value="<%= search %>">
            <input type="hidden" name="sort" value="<%= sort %>">
            <button type="submit" class="btn">Знайти</button>
        </div>
      </form>

      <div class="sort-group">
        <label for="sort-select">Сортування:</label>
        <select id="sort-select" class="select-input" onchange="location = this.value;">
          <option value="/?search=<%= encodeURIComponent(search) %>&sort=newest&page=1" <%= sort === 'newest' ? 'selected' : '' %>>Новіші спочатку</option>
          <option value="/?search=<%= encodeURIComponent(search) %>&sort=oldest&page=1" <%= sort === 'oldest' ? 'selected' : '' %>>Старіші спочатку</option>
        </select>
      </div>
    </div>

    <div class="cards-grid">
      <% if (announcements.length === 0) { %>
        <div style="text-align: center; padding: 40px;" class="card">
          <h3 style="color: var(--text-muted);">Жодного оголошення не знайдено...</h3>
        </div>
      <% } else { %>
        <% announcements.forEach(ann => { %>
          <div class="card">
            <div class="card-header">
              <h2 style="color: var(--primary);" class="card-title"><%= ann.title %></h2>
              <span class="badge" style="background: #eef2ff; padding: 4px 8px; border-radius: 4px;"><%= categoryMap[ann.category] || ann.category %></span>
            </div>
            <p class="card-desc">
              <%= ann.description.length > 100 ? ann.description.substring(0, 100) + '...' : ann.description %>
            </p>
            <div class="card-footer">
              <span class="price"><%= ann.price %> грн</span>
              <span class="date">📅 <%= new Date(ann.createdAt).toLocaleDateString('uk-UA') %></span>
              <a href="/announcements/<%= ann.id %>" class="link-more">Детальніше →</a>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>

    <% if (totalPages > 1) { %>
      <div class="pagination">
        <a href="/?page=<%= currentPage - 1 %>&search=<%= encodeURIComponent(search) %>&sort=<%= sort %>" 
           class="page-link <%= currentPage === 1 ? 'disabled' : '' %>">Попередня</a>

        <% for(let i = 1; i <= totalPages; i++) { %>
          <a href="/?page=<%= i %>&search=<%= encodeURIComponent(search) %>&sort=<%= sort %>" 
             class="page-link <%= currentPage === i ? 'active' : '' %>"><%= i %></a>
        <% } %>

        <a href="/?page=<%= currentPage + 1 %>&search=<%= encodeURIComponent(search) %>&sort=<%= sort %>" 
           class="page-link <%= currentPage === totalPages ? 'disabled' : '' %>">Наступна</a>
      </div>
    <% } %>
  </div>
</body>
</html>