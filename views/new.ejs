<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <title>Створити оголошення</title>
  <link rel="stylesheet" href="./styles.css">
</head>
<body>
  <div class="container">
    <header>
      <h1><a href="/">📝 Нове оголошення</a></h1>
    </header>

    <form action="/announcements" method="POST" style="background: #fff; padding: 25px; border-radius: 8px; border:1px solid var(--border-color);">
      
      <div class="form-group">
        <label>Категорія *</label>
        <div class="radio-group">
          <label class="radio-label">
            <input type="radio" name="category" value="sale" <%= data?.category === 'sale' ? 'checked' : '' %>>
            📦 Продаж
          </label>
          <label class="radio-label">
            <input type="radio" name="category" value="service" <%= data?.category === 'service' ? 'checked' : '' %>>
            🔧 Послуги
          </label>
          <label class="radio-label">
            <input type="radio" name="category" value="job" <%= data?.category === 'job' ? 'checked' : '' %>>
            💼 Робота
          </label>
          <label class="radio-label">
            <input type="radio" name="category" value="other" <%= data?.category === 'other' ? 'checked' : '' %>>
            📌 Інше
          </label>
        </div>
        <% if (errors.category) { %>
          <span class="error-msg"><%= errors.category %></span>
        <% } %>
      </div>

      <div class="form-group">
        <label for="title">Назва оголошення *</label>
        <input type="text" id="title" name="title" class="input-text" placeholder="Коротка назва оголошення" minlength="5" maxlength="100" value="<%= data?.title || '' %>">
        <% if (errors.title) { %>
          <span class="error-msg"><%= errors.title %></span>
        <% } %>
      </div>

      <div class="form-group">
        <label for="description">Детальний опис *</label>
        <textarea id="description" name="description" class="textarea-input" rows="6" placeholder="Детальний опис оголошення..." minlength="10"><%= data?.description || '' %></textarea>
        <% if (errors.description) { %>
          <span class="error-msg"><%= errors.description %></span>
        <% } %>
      </div>

      <div class="form-group">
        <label for="price">Ціна (грн) *</label>
        <input type="number" id="price" name="price" class="input-text" min="0.01" step="0.01" placeholder="0.00" value="<%= data?.price || '' %>">
        <% if (errors.price) { %>
          <span class="error-msg"><%= errors.price %></span>
        <% } %>
      </div>

      <div class="form-group">
        <label for="contactInfo">Контактна інформація *</label>
        <input type="text" id="contactInfo" name="contactInfo" class="input-text" placeholder="Email або телефон" minlength="5" value="<%= data?.contactInfo || '' %>">
        <% if (errors.contactInfo) { %>
          <span class="error-msg"><%= errors.contactInfo %></span>
        <% } %>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn">Опублікувати</button>
        <a href="/" class="btn btn-secondary">Скасувати</a>
      </div>
    </form>
  </div>
</body>
</html>